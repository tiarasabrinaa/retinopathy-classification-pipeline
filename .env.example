# Copy this file to .env (kept out of git) and fill in your own values.
# Loaded by src/mlflow_utils.py via python-dotenv-style os.environ lookups.

# --- Databricks Community Edition MLflow tracking ---
# Create a Personal Access Token at: Databricks CE -> Settings -> Developer -> Access tokens
# Docs: https://docs.databricks.com/en/dev-tools/auth/pat.html
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=

# Experiment must live under your Databricks workspace user folder, e.g.
# /Users/your-databricks-login-email/retinopathy-disease-classification
MLFLOW_EXPERIMENT_NAME=/Users/CHANGE_ME/retinopathy-disease-classification
